{
  "$id": "https://jumbo.local/schema/PanelsDoc.schema.json",
  "title": "PanelsDoc",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "chapter_id": {
      "type": "string",
      "pattern": "^ch_\\d{4}$"
    },
    "layout": {
      "type": "string",
      "enum": [
        "strip",
        "page"
      ]
    },
    "panels": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^p_\\d{4}$"
          },
          "order": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "page": {
            "type": "string",
            "minLength": 1
          },
          "page_size": {
            "type": "object",
            "properties": {
              "width": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "height": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "width",
              "height"
            ]
          },
          "bbox": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "w": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              },
              "h": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "x",
              "y",
              "w",
              "h"
            ]
          },
          "polygon": {
            "minItems": 3,
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "crop": {
            "type": "string",
            "minLength": 1
          },
          "clean": {
            "type": "string",
            "minLength": 1
          },
          "bubbles": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^b_\\d{4}$"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "speech",
                    "thought",
                    "narration",
                    "sfx"
                  ]
                },
                "polygon": {
                  "minItems": 3,
                  "type": "array",
                  "items": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    ],
                    "items": false,
                    "minItems": 2,
                    "maxItems": 2
                  }
                },
                "text": {
                  "type": "string"
                },
                "speaker": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "id",
                "kind",
                "polygon"
              ]
            }
          },
          "characters": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "cluster": {
                  "type": "string",
                  "minLength": 1
                },
                "bbox": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "w": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 1
                    },
                    "h": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": [
                    "x",
                    "y",
                    "w",
                    "h"
                  ]
                }
              },
              "required": [
                "cluster",
                "bbox"
              ]
            }
          }
        },
        "required": [
          "id",
          "order",
          "page",
          "page_size",
          "bbox",
          "polygon"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "chapter_id",
    "layout",
    "panels"
  ]
}
