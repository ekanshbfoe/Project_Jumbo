{
  "$id": "https://jumbo.local/schema/PanelsDoc.schema.json",
  "title": "PanelsDoc",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "chapter_id": {
      "type": "string",
      "pattern": "^ch_\\d{4}$"
    },
    "layout": {
      "type": "string",
      "enum": [
        "strip",
        "page"
      ]
    },
    "panels": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/Panel"
      }
    },
    "fingerprints": {
      "$ref": "#/$defs/Fingerprints"
    }
  },
  "required": [
    "schema_version",
    "chapter_id",
    "layout",
    "panels"
  ],
  "$defs": {
    "Panel": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^p_\\d{4}$"
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "page": {
          "type": "string",
          "minLength": 1
        },
        "page_size": {
          "$ref": "#/$defs/ImageSize"
        },
        "bbox": {
          "$ref": "#/$defs/BBox"
        },
        "polygon": {
          "$ref": "#/$defs/Polygon"
        },
        "crop": {
          "type": "string",
          "minLength": 1
        },
        "clean": {
          "type": "string",
          "minLength": 1
        },
        "bubbles": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/$defs/Bubble"
          }
        },
        "characters": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/$defs/CharacterBox"
          }
        }
      },
      "required": [
        "id",
        "order",
        "page",
        "page_size",
        "bbox",
        "polygon"
      ]
    },
    "ImageSize": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "width",
        "height"
      ]
    },
    "BBox": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "w": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "h": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "x",
        "y",
        "w",
        "h"
      ]
    },
    "Polygon": {
      "minItems": 3,
      "type": "array",
      "items": {
        "$ref": "#/$defs/Point"
      }
    },
    "Point": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "Bubble": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^b_\\d{4}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "speech",
            "thought",
            "narration",
            "sfx"
          ]
        },
        "polygon": {
          "$ref": "#/$defs/Polygon"
        },
        "text": {
          "type": "string"
        },
        "speaker": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "polygon"
      ]
    },
    "CharacterBox": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^k_\\d{4,}$"
        },
        "cluster": {
          "type": "string",
          "minLength": 1
        },
        "bbox": {
          "$ref": "#/$defs/BBox"
        }
      },
      "required": [
        "cluster",
        "bbox"
      ]
    },
    "Fingerprints": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "dtype": {
          "type": "string",
          "const": "float16"
        },
        "dim": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "model": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path",
        "dtype",
        "dim",
        "count",
        "model"
      ]
    }
  }
}
