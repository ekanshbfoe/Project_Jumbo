{
  "$id": "https://jumbo.local/schema/SessionTicket.schema.json",
  "title": "SessionTicket",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "proto": {
      "type": "number",
      "const": 1
    },
    "session_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "app_pk": {
      "type": "string",
      "format": "base64",
      "contentEncoding": "base64",
      "pattern": "^$|^(?:[0-9a-zA-Z+/]{4})*(?:(?:[0-9a-zA-Z+/]{2}==)|(?:[0-9a-zA-Z+/]{3}=))?$"
    },
    "deadline_s": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "idle_s": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "rendezvous": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "gist"
            },
            "gist_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "gist_id"
          ]
        }
      ]
    }
  },
  "required": [
    "proto",
    "session_id",
    "app_pk",
    "deadline_s",
    "idle_s",
    "rendezvous"
  ]
}
