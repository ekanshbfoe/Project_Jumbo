{
  "$id": "https://jumbo.local/schema/AudioManifest.schema.json",
  "title": "AudioManifest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "chapter_id": {
      "type": "string",
      "pattern": "^ch_\\d{4}$"
    },
    "sample_rate": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "clips": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AudioClip"
      }
    }
  },
  "required": [
    "schema_version",
    "chapter_id",
    "sample_rate",
    "clips"
  ],
  "$defs": {
    "AudioClip": {
      "type": "object",
      "properties": {
        "line_id": {
          "type": "string",
          "pattern": "^l_\\d{4}$"
        },
        "src": {
          "type": "string",
          "minLength": 1
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "line_id",
        "src",
        "duration"
      ]
    }
  }
}
