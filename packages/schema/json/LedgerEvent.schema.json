{
  "$id": "https://jumbo.local/schema/LedgerEvent.schema.json",
  "title": "LedgerEvent",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "commit": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "part": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "parts": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "chapter_id": {
      "type": "string",
      "pattern": "^ch_\\d{4}$"
    },
    "session": {
      "type": "string",
      "minLength": 1
    },
    "op": {
      "oneOf": [
        {
          "$ref": "#/$defs/AddOp"
        },
        {
          "$ref": "#/$defs/UpdateOp"
        },
        {
          "$ref": "#/$defs/DeleteOp"
        },
        {
          "$ref": "#/$defs/MergeOp"
        },
        {
          "$ref": "#/$defs/NoopOp"
        }
      ]
    },
    "prev": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "seq",
    "commit",
    "part",
    "parts",
    "ts",
    "chapter_id",
    "op",
    "prev",
    "hash"
  ],
  "$defs": {
    "AddOp": {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "ADD"
        },
        "entity_type": {
          "type": "string",
          "enum": [
            "character",
            "faction",
            "location",
            "item",
            "relationship",
            "plot_thread"
          ]
        },
        "entity_id": {
          "type": "string",
          "pattern": "^[a-z]+(?:_[a-z0-9]+)+$"
        },
        "data": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "receipts": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Receipt"
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "op",
        "entity_type",
        "entity_id",
        "data",
        "receipts",
        "confidence"
      ]
    },
    "Receipt": {
      "type": "object",
      "properties": {
        "chapter_id": {
          "type": "string",
          "pattern": "^ch_\\d{4}$"
        },
        "panel_id": {
          "type": "string",
          "pattern": "^p_\\d{4}$"
        },
        "quote": {
          "type": "string",
          "maxLength": 500
        }
      },
      "required": [
        "chapter_id",
        "panel_id"
      ]
    },
    "UpdateOp": {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "UPDATE"
        },
        "entity_type": {
          "type": "string",
          "enum": [
            "character",
            "faction",
            "location",
            "item",
            "relationship",
            "plot_thread"
          ]
        },
        "entity_id": {
          "type": "string",
          "pattern": "^[a-z]+(?:_[a-z0-9]+)+$"
        },
        "field": {
          "type": "string",
          "pattern": "^[a-z0-9_]+(?:\\.[a-z0-9_]+)*$"
        },
        "value": {},
        "receipts": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Receipt"
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "op",
        "entity_type",
        "entity_id",
        "field",
        "value",
        "receipts",
        "confidence"
      ]
    },
    "DeleteOp": {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "DELETE"
        },
        "entity_type": {
          "type": "string",
          "enum": [
            "character",
            "faction",
            "location",
            "item",
            "relationship",
            "plot_thread"
          ]
        },
        "entity_id": {
          "type": "string",
          "pattern": "^[a-z]+(?:_[a-z0-9]+)+$"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "receipts": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Receipt"
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "op",
        "entity_type",
        "entity_id",
        "reason",
        "receipts",
        "confidence"
      ]
    },
    "MergeOp": {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "MERGE"
        },
        "entity_type": {
          "type": "string",
          "enum": [
            "character",
            "faction",
            "location",
            "item",
            "relationship",
            "plot_thread"
          ]
        },
        "entity_id": {
          "type": "string",
          "pattern": "^[a-z]+(?:_[a-z0-9]+)+$"
        },
        "from_id": {
          "type": "string",
          "pattern": "^[a-z]+(?:_[a-z0-9]+)+$"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "receipts": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Receipt"
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "op",
        "entity_type",
        "entity_id",
        "from_id",
        "reason",
        "receipts",
        "confidence"
      ]
    },
    "NoopOp": {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "NOOP"
        },
        "reason": {
          "type": "string",
          "maxLength": 300
        }
      },
      "required": [
        "op"
      ]
    }
  }
}
