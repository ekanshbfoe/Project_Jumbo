{
  "$id": "https://jumbo.local/schema/ScriptDoc.schema.json",
  "title": "ScriptDoc",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "chapter_id": {
      "type": "string",
      "pattern": "^ch_\\d{4}$"
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "lines": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^l_\\d{4}$"
          },
          "panel_ids": {
            "minItems": 1,
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^p_\\d{4}$"
            }
          },
          "narration": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "emotion": {
            "type": "string",
            "enum": [
              "calm",
              "tense",
              "action",
              "shock",
              "sad",
              "comedic",
              "romantic",
              "mysterious",
              "triumphant"
            ]
          },
          "voice": {
            "default": {},
            "type": "object",
            "properties": {
              "tone": {
                "default": "neutral",
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "pace": {
                "default": "normal",
                "type": "string",
                "enum": [
                  "slow",
                  "normal",
                  "fast"
                ]
              },
              "intensity": {
                "default": 0.5,
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "preset": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "const": "hold"
                  },
                  "params": {
                    "default": {},
                    "type": "object",
                    "properties": {}
                  }
                },
                "required": [
                  "name"
                ],
                "description": "Static panel. Use for quiet exposition or dialogue-heavy beats."
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "const": "zoom"
                  },
                  "params": {
                    "default": {},
                    "type": "object",
                    "properties": {
                      "from": {
                        "default": 1,
                        "type": "number",
                        "minimum": 0.5,
                        "maximum": 3
                      },
                      "to": {
                        "default": 1.15,
                        "type": "number",
                        "minimum": 0.5,
                        "maximum": 3
                      },
                      "focus": {
                        "type": "array",
                        "prefixItems": [
                          {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          },
                          {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          }
                        ],
                        "items": false,
                        "minItems": 2,
                        "maxItems": 2
                      }
                    }
                  }
                },
                "required": [
                  "name"
                ],
                "description": "Smooth push in (to > from) or pull out (to < from), optionally centred on a focus point such as a face."
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "const": "pan"
                  },
                  "params": {
                    "default": {},
                    "type": "object",
                    "properties": {
                      "direction": {
                        "default": "right",
                        "type": "string",
                        "enum": [
                          "left",
                          "right",
                          "up",
                          "down"
                        ]
                      },
                      "distance": {
                        "default": 0.08,
                        "type": "number",
                        "minimum": 0,
                        "maximum": 0.5
                      }
                    }
                  }
                },
                "required": [
                  "name"
                ],
                "description": "Slow camera drift across the panel. Use for establishing shots and wide panels."
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "const": "shake"
                  },
                  "params": {
                    "default": {},
                    "type": "object",
                    "properties": {
                      "intensity": {
                        "default": 12,
                        "type": "number",
                        "minimum": 0,
                        "maximum": 60
                      },
                      "frequency": {
                        "default": 12,
                        "type": "number",
                        "minimum": 1,
                        "maximum": 30
                      }
                    }
                  }
                },
                "required": [
                  "name"
                ],
                "description": "Continuous camera shake. Use for rumbling, explosions or sustained tension."
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "const": "action_tilt"
                  },
                  "params": {
                    "default": {},
                    "type": "object",
                    "properties": {
                      "angle": {
                        "default": 6,
                        "type": "number",
                        "minimum": -20,
                        "maximum": 20
                      },
                      "punch": {
                        "default": 1.12,
                        "type": "number",
                        "minimum": 1,
                        "maximum": 1.5
                      }
                    }
                  }
                },
                "required": [
                  "name"
                ],
                "description": "Fast punch-in with a dutch tilt that settles. Use for hits, reveals and sudden action."
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "const": "kinetic_jitter"
                  },
                  "params": {
                    "default": {},
                    "type": "object",
                    "properties": {
                      "intensity": {
                        "default": 18,
                        "type": "number",
                        "minimum": 0,
                        "maximum": 60
                      },
                      "decay": {
                        "default": 0.35,
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    }
                  }
                },
                "required": [
                  "name"
                ],
                "description": "Violent jitter that decays over the beat. Use for impacts, shock and screams."
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "const": "panoramic_fade"
                  },
                  "params": {
                    "default": {},
                    "type": "object",
                    "properties": {
                      "direction": {
                        "default": "right",
                        "type": "string",
                        "enum": [
                          "left",
                          "right",
                          "up",
                          "down"
                        ]
                      },
                      "fade": {
                        "default": 0.2,
                        "type": "number",
                        "minimum": 0,
                        "maximum": 0.5
                      }
                    }
                  }
                },
                "required": [
                  "name"
                ],
                "description": "Wide pan that fades in and out. Use for scene changes, flashbacks and time skips."
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "const": "split_screen"
                  },
                  "params": {
                    "default": {},
                    "type": "object",
                    "properties": {
                      "orientation": {
                        "default": "vertical",
                        "type": "string",
                        "enum": [
                          "vertical",
                          "horizontal"
                        ]
                      },
                      "stagger": {
                        "default": 0.25,
                        "type": "number",
                        "minimum": 0,
                        "maximum": 2
                      }
                    }
                  }
                },
                "required": [
                  "name"
                ],
                "description": "Two or three panels share the frame and slide in one after another. Use for confrontations and parallel reactions."
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "const": "floating_panels"
                  },
                  "params": {
                    "default": {},
                    "type": "object",
                    "properties": {
                      "tilt": {
                        "default": 4,
                        "type": "number",
                        "minimum": 0,
                        "maximum": 12
                      },
                      "drift": {
                        "default": 6,
                        "type": "number",
                        "minimum": 0,
                        "maximum": 15
                      },
                      "period": {
                        "default": 10,
                        "type": "number",
                        "minimum": 3,
                        "maximum": 30
                      }
                    }
                  }
                },
                "required": [
                  "name"
                ],
                "description": "Two or three tall panels float over the background like physical photos layered in 3D, with heavy shadows and a slow drift. Use for character introductions, line-ups and reflective moments."
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "const": "horizontal_slices"
                  },
                  "params": {
                    "default": {},
                    "type": "object",
                    "properties": {
                      "drift": {
                        "default": 0.05,
                        "type": "number",
                        "minimum": 0,
                        "maximum": 0.2
                      },
                      "lead": {
                        "default": "left",
                        "type": "string",
                        "enum": [
                          "left",
                          "right"
                        ]
                      }
                    }
                  }
                },
                "required": [
                  "name"
                ],
                "description": "Two or three ultra-wide, short panels stacked as strips that drift slowly in opposite directions. Use for intimate close-ups, eye contact and tense stare-downs."
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "const": "hud_popup"
                  },
                  "params": {
                    "default": {},
                    "type": "object",
                    "properties": {
                      "text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120
                      },
                      "position": {
                        "default": "top",
                        "type": "string",
                        "enum": [
                          "top",
                          "center",
                          "bottom"
                        ]
                      },
                      "accent": {
                        "default": "#3ad6ff",
                        "type": "string",
                        "pattern": "^#[0-9a-fA-F]{6}$"
                      }
                    },
                    "required": [
                      "text"
                    ]
                  }
                },
                "required": [
                  "name"
                ],
                "description": "Game-style info panel types onto the screen over the panel. Use for system messages, stats and level-ups."
              }
            ]
          },
          "transition_in": {
            "default": {},
            "type": "object",
            "properties": {
              "name": {
                "default": "cut",
                "type": "string",
                "enum": [
                  "cut",
                  "fade",
                  "slide",
                  "wipe"
                ]
              },
              "duration": {
                "default": 0.4,
                "type": "number",
                "minimum": 0,
                "maximum": 1.5
              }
            }
          }
        },
        "required": [
          "id",
          "panel_ids",
          "narration",
          "emotion",
          "preset"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "chapter_id",
    "lines"
  ]
}
